# ==============================================================================
# Apache Configuration: Security Headers, Protection & Clean URLs
# ==============================================================================

# Disable directory browsing
Options -Indexes

# ----------------------------------------------------------------------
# 1. Security Headers (mod_headers)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Enforce HTTPS
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
  # Prevent MIME sniffing
  Header set X-Content-Type-Options "nosniff"
  # Clickjacking mitigation
  Header set X-Frame-Options "SAMEORIGIN"
  # Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Permissions Policy
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), screen-wake-lock=()"
  # Content Security Policy
  Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net data:; img-src 'self' data: https://raw.githubusercontent.com; connect-src 'self' https://api.open-meteo.com; frame-ancestors 'self'; form-action 'self'; base-uri 'self';"
</IfModule>

# ----------------------------------------------------------------------
# 2. Block sensitive files, dotfiles, and agent configurations
# ----------------------------------------------------------------------
<IfModule mod_authz_core.c>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
  <FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op]|md|json)|~)$">
    Require all denied
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# 3. Clean Extensionless URLs (mod_rewrite)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect /index.html and /index to /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/index(\.html)?[\s\?] [NC]
  RewriteRule ^index(\.html)?$ / [R=301,L]

  # Redirect /page.html to /page (External 301 Redirect)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^\s]+)\.html[\s\?] [NC]
  RewriteRule ^%1$ /%1 [R=301,L]

  # Internally rewrite /page to /page.html if the file exists
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>
